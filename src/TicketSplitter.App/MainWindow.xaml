<Window
    x:Class="TicketSplitter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TicketSplitter.App.ViewModels"
    xmlns:steps="using:TicketSplitter.App.Steps"
    Title="作业票切分工具">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="15"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="作业票切分工具" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="提交 PDF → 选择样式 → 切开 → MinerU 识别 → 核对导出"
                           FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" Margin="18,0,18,12" ItemsSource="{x:Bind ViewModel.Steps}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{x:Bind BadgeBrush}">
                            <TextBlock Text="{x:Bind NumberText}" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="{x:Bind TitleWeight}"
                                   Opacity="{x:Bind TextOpacity}" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Opacity="0.35"
                                  Visibility="{x:Bind ShowArrow}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Padding="18,0,18,8">
            <steps:SubmitStep Visibility="{x:Bind ViewModel.IsOnSubmitStep, Mode=OneWay}" />
            <steps:LayoutStep Visibility="{x:Bind ViewModel.IsOnLayoutStep, Mode=OneWay}" />
            <steps:SplitStep Visibility="{x:Bind ViewModel.IsOnSplitStep, Mode=OneWay}" />
            <steps:ParseStep Visibility="{x:Bind ViewModel.IsOnParseStep, Mode=OneWay}" />
            <steps:ReviewStep Visibility="{x:Bind ViewModel.IsOnReviewStep, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3" Padding="18,0,18,10" ColumnSpacing="10" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Content="{x:Bind ViewModel.BackText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
            <Button Grid.Column="2" Content="{x:Bind ViewModel.NextText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.GoNextCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="4" Padding="18,6,18,8" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="12" Opacity="0.6"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12"
                       Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="2" Width="160" Height="3" VerticalAlignment="Center"
                         Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{x:Bind ViewModel.ProgressIsIndeterminate, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>