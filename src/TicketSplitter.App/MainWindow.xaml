<Window
    x:Class="TicketSplitter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TicketSplitter.App.ViewModels"
    Title="作业票切分工具">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="46" Padding="14,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="15"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="作业票切分工具" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="扫描件 PDF → 按票种 / 区域切分" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="392,*">

            <ScrollViewer Grid.Column="0" Padding="14,2,10,16">
                <StackPanel Spacing="12">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="1 · 源文件与版式" Style="{StaticResource SectionTitleStyle}" />
                            <Button Content="选择 PDF 文件…" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.PickSourceCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.SourceInfo, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                            <InfoBar IsOpen="{x:Bind ViewModel.HasLayout, Mode=OneWay}" IsClosable="False"
                                     Severity="Informational"
                                     Title="{x:Bind ViewModel.LayoutLabel, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.LayoutDetail, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.LayoutNotes, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="版式处理方式" FontSize="12" Opacity="0.8" />
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.LayoutModeIndex, Mode=TwoWay}"
                                          MaxColumns="3">
                                <x:String>自动</x:String>
                                <x:String>半幅</x:String>
                                <x:String>整版</x:String>
                            </RadioButtons>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="2 · MinerU 解析" Style="{StaticResource SectionTitleStyle}" />
                            <PasswordBox Header="MinerU Token" Password="{x:Bind ViewModel.Token, Mode=TwoWay}"
                                         PlaceholderText="粘贴 Token，或使用环境变量 MINERU_TOKEN" />
                            <CheckBox Content="记住 Token（DPAPI 加密保存在本机）"
                                      IsChecked="{x:Bind ViewModel.RememberToken, Mode=TwoWay}" />
                            <CheckBox Content="复用已有解析结果（不联网）"
                                      IsChecked="{x:Bind ViewModel.ReuseExistingParse, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanReuseExisting, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="开始解析" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.StartParseCommand}" />
                                <Button Grid.Column="1" Content="取消"
                                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.CancelCommand}" />
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind ViewModel.ProgressIsIndeterminate, Mode=OneWay}"
                                         Maximum="100" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="3 · 归档导出" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TicketSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}"
                                         PlaceholderText="输出目录" />
                                <Button Grid.Column="1" Content="浏览…"
                                        Command="{x:Bind ViewModel.PickOutputDirCommand}" />
                            </Grid>
                            <CheckBox Content="导出前清空上次的票类型目录"
                                      IsChecked="{x:Bind ViewModel.CleanOutput, Mode=TwoWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="导出单票 + CSV" HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.ExportCommand}" />
                                <Button Grid.Column="1" Content="打开目录"
                                        Command="{x:Bind ViewModel.OpenOutputCommand}" />
                            </Grid>
                            <InfoBar IsOpen="{x:Bind ViewModel.HasExport, Mode=OneWay}" IsClosable="False"
                                     Severity="Success" Title="导出完成"
                                     Message="{x:Bind ViewModel.LastExportInfo, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="4 · 产出体检" Style="{StaticResource SectionTitleStyle}" />
                            <InfoBar IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" IsClosable="False"
                                     Severity="Warning"
                                     Title="{x:Bind ViewModel.WarningHeader, Mode=OneWay}"
                                     Message="以下票建议人工核对后再交付。" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WarningList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionStyle}"
                                                   Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="0,2,14,16">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="0,0,0,10">
                    <Button Content="从此页切开" Command="{x:Bind ViewModel.SplitAtPageCommand}" />
                    <Button Content="并入上一张" Command="{x:Bind ViewModel.MergePreviousCommand}" />
                    <Button Content="删除选中票" Command="{x:Bind ViewModel.DeleteTicketCommand}" />
                    <Button Content="恢复自动切分" Command="{x:Bind ViewModel.ResetBoundariesCommand}" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="272,*">

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="页面（色块 = 所属票号）"
                                       Style="{StaticResource CaptionStyle}" Margin="4,2,4,6" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Pages}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageThumbViewModel">
                                        <Grid ColumnSpacing="8" Padding="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind PageNumberText}"
                                                       FontSize="11" Opacity="0.7" VerticalAlignment="Top" />
                                            <Border Grid.Column="1" Background="White" CornerRadius="3"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                       Stretch="Uniform" Height="86" />
                                            </Border>
                                            <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                                    VerticalAlignment="Top"
                                                    Background="{x:Bind BadgeBrush, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="11"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="8" Margin="12,0,0,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="切分结果" Style="{StaticResource SectionTitleStyle}"
                                       Margin="4,0,0,8" />

                            <Grid Grid.Row="1" ColumnSpacing="8" Padding="8,0,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="票类型" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="施工区域" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="施工时间" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="起止页" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="页数" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="提示" Style="{StaticResource ColumnHeaderStyle}" />
                            </Grid>

                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Tickets}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TicketRowViewModel">
                                        <Grid ColumnSpacing="8" Padding="8,7" ToolTipService.ToolTip="{x:Bind IssueText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind IndexText}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Border Width="4" Height="16" CornerRadius="2"
                                                        Background="{x:Bind TypeBrush}" />
                                                <TextBlock Text="{x:Bind Type}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Area}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Time}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind PageRange}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind PageCountText}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="6" Glyph="&#xE7BA;" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Visibility="{x:Bind HasIssue, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
