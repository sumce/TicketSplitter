<Window
    x:Class="TicketSplitter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TicketSplitter.App.ViewModels"
    Title="作业票切分工具">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="14,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="15"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="作业票切分工具" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="扫描件 PDF → 按票种 / 区域切分" FontSize="12" Opacity="0.55"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="14,0,14,8" ColumnSpacing="10"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Content="选择 PDF" VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.PickSourceCommand}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="240" />
                <Border Style="{StaticResource PillStyle}">
                    <TextBlock Text="{x:Bind ViewModel.SourceMeta, Mode=OneWay}" FontSize="11" Opacity="0.8" />
                </Border>
                <Border Style="{StaticResource PillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C3;" FontSize="11"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LayoutShort, Mode=OneWay}" FontSize="11" />
                    </StackPanel>
                </Border>
                <ComboBox SelectedIndex="{x:Bind ViewModel.LayoutModeIndex, Mode=TwoWay}"
                          MinWidth="104" VerticalAlignment="Center">
                    <ComboBoxItem Content="自动识别" />
                    <ComboBoxItem Content="按半幅" />
                    <ComboBoxItem Content="按整版" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ToggleButton IsChecked="{x:Bind ViewModel.ShowPages, Mode=TwoWay}"
                              VerticalAlignment="Center" ToolTipService.ToolTip="显示 / 隐藏页面缩略图">
                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                </ToggleButton>
                <Button Content="{x:Bind ViewModel.TokenButtonText, Mode=OneWay}"
                        VerticalAlignment="Center" Click="OnTokenClick" />
                <Button Content="开始解析" VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.HasSource, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StartParseCommand}" />
                <Button Content="取消" VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelCommand}" />
                <Button Content="导出…" VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasTickets, Mode=OneWay}"
                        Click="OnExportClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="14,0,14,8" ColumnSpacing="10" ColumnDefinitions="*,Auto">

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" Padding="12,10,12,6" ColumnSpacing="8"
                          ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="切分结果" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TicketSummary, Mode=OneWay}" FontSize="12"
                                       Opacity="0.65" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="恢复自动切分" FontSize="12" Padding="10,4"
                                IsEnabled="{x:Bind ViewModel.HasTickets, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ResetBoundariesCommand}" />
                    </Grid>

                    <InfoBar Grid.Row="1" Margin="10,0,10,6"
                             IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" IsClosable="False"
                             Severity="Warning"
                             Title="{x:Bind ViewModel.WarningHeader, Mode=OneWay}"
                             Message="已在下方「状态」列标出，建议人工核对后再交付。" />

                    <Grid Grid.Row="2" ColumnSpacing="8" Padding="12,0,12,6"
                          ColumnDefinitions="44,124,96,180,96,52,*">
                        <TextBlock Grid.Column="0" Text="序号" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="票类型" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="施工区域" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="施工时间" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="起止页" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="页数" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>

                    <ListView x:Name="TicketsList" Grid.Row="3" Padding="0"
                              ItemsSource="{x:Bind ViewModel.Tickets}"
                              SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=TwoWay}"
                              SelectionMode="Single" SelectionChanged="OnTicketsSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TicketRowViewModel">
                                <Grid ColumnSpacing="8" Padding="12,7"
                                      ToolTipService.ToolTip="{x:Bind IssueText}"
                                      ColumnDefinitions="44,124,96,180,96,52,*">
                                    <TextBlock Grid.Column="0" Text="{x:Bind IndexText}"
                                               Style="{StaticResource CellStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Width="3" Height="16" CornerRadius="2"
                                                Background="{x:Bind TypeBrush}" />
                                        <TextBlock Text="{x:Bind Type}" Style="{StaticResource CellStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Area}"
                                               Style="{StaticResource CellStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Time}"
                                               Style="{StaticResource CellStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind PageRange}"
                                               Style="{StaticResource CellStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind PageCountText}"
                                               Style="{StaticResource CellStyle}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasIssue, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{x:Bind IssueShort}" FontSize="12"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="280" Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{x:Bind ViewModel.ShowPages, Mode=OneWay}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" Padding="12,10,12,6" ColumnSpacing="8" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="页面" Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedPageLabel, Mode=OneWay}"
                                   FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1" Padding="10,0,10,8" ColumnSpacing="6"
                          ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Content="切开" FontSize="12" Padding="0,4"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanEditBoundary, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SplitAtPageCommand}"
                                ToolTipService.ToolTip="以选中页为首页，切成新的一张票" />
                        <Button Grid.Column="1" Content="并入上张" FontSize="12" Padding="0,4"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanEditBoundary, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MergePreviousCommand}"
                                ToolTipService.ToolTip="把选中页所在的票并入上一张票" />
                        <Button Grid.Column="2" Content="删除" FontSize="12" Padding="0,4"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.HasTickets, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DeleteTicketCommand}"
                                ToolTipService.ToolTip="删除选中的票（其页面不再归档）" />
                    </Grid>

                    <ListView x:Name="PagesList" Grid.Row="2" Padding="0"
                              ItemsSource="{x:Bind ViewModel.Pages}"
                              SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=TwoWay}"
                              SelectionMode="Single" SelectionChanged="OnPagesSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageThumbViewModel">
                                <Grid ColumnSpacing="8" Padding="2,3" ColumnDefinitions="24,*,26">
                                    <TextBlock Grid.Column="0" Text="{x:Bind PageNumberText}" FontSize="11"
                                               Opacity="0.7" VerticalAlignment="Top" />
                                    <Border Grid.Column="1" Background="White" CornerRadius="3"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"
                                               Height="150" />
                                    </Border>
                                    <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12"
                                            VerticalAlignment="Top"
                                            Background="{x:Bind BadgeBrush, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="10"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.NoSource, Mode=OneWay}">
                <FontIcon Glyph="&#xE8A5;" FontSize="40" Opacity="0.35" />
                <TextBlock Text="选择一个扫描件作业票 PDF 开始" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Text="自动识别整版 / 半幅版式，MinerU 解析后按票种切分并归档为单票 PDF 与清单 CSV" />
                <Button Content="选择 PDF" HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.PickSourceCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Padding="14,6,14,8" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              ColumnDefinitions="Auto,*,Auto,Auto">
            <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="12" Opacity="0.6"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="12" Opacity="0.8" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="2" Width="180" Height="3" VerticalAlignment="Center"
                         Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{x:Bind ViewModel.ProgressIsIndeterminate, Mode=OneWay}" />
            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.OutputDir, Mode=OneWay}"
                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </Grid>
    </Grid>
</Window>