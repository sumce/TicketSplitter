<UserControl
    x:Class="TicketSplitter.App.Steps.ParseStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TicketSplitter.App.Steps">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="交给 MinerU 识别" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource CaptionStyle}"
                       Text="识别的作用是找出每页上的票标题，据此确定每张票的起止页。送上去的是上一步切开后的文件。" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="14">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Left">

                    <local:ChunkPlanPanel />

                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="识别设置" Style="{StaticResource PanelTitleStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <PasswordBox Grid.Column="0" Header="MinerU Token"
                                             Password="{Binding Token, Mode=TwoWay}"
                                             PlaceholderText="粘贴 Token，或使用环境变量 MINERU_TOKEN" />
                                <Button Grid.Column="1" Content="清除" VerticalAlignment="Bottom"
                                        MinWidth="64" Command="{Binding ClearTokenCommand}"
                                        ToolTipService.ToolTip="清掉本机保存的 Token" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="Token 会用 DPAPI 加密一直保存在本机，下次打开自动带上；只有在失效时才会被清除并提示重新填写。" />
                            <CheckBox Content="复用已有识别结果（不联网，跳过 MinerU 调用）"
                                      IsChecked="{Binding ReuseExistingParse, Mode=TwoWay}"
                                      IsEnabled="{Binding CanReuseExisting}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="开始识别" MinWidth="150"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{Binding HasChunkProblems, Converter={StaticResource BoolToVisInv}}"
                                        Command="{Binding StartParseCommand}" />
                                <Button Content="取消" MinWidth="72"
                                        IsEnabled="{Binding IsBusy}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <ProgressBar Maximum="100" Value="{Binding ProgressValue}"
                                         IsIndeterminate="{Binding ProgressIsIndeterminate}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="本次识别的输入" Style="{StaticResource PanelTitleStyle}" />
                    <TextBlock Text="{Binding SourceName}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SplitSummary}" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding TicketSummary}" Style="{StaticResource CaptionStyle}" />
                    <InfoBar IsOpen="{Binding HasWarnings}" IsClosable="False" Severity="Warning"
                             Title="{Binding WarningHeader}" Message="识别完成后可在下一步逐张核对。" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>