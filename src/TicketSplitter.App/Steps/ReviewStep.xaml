<UserControl
    x:Class="TicketSplitter.App.Steps.ReviewStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Text="核对切分结果" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TicketSummary}" Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="恢复自动切分" Command="{Binding ResetBoundariesCommand}" />
                <Button Content="导出…" Style="{StaticResource AccentButtonStyle}" Click="OnExportClick" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar IsOpen="{Binding HasWarnings}" IsClosable="False" Severity="Warning"
                     Title="{Binding WarningHeader}"
                     Message="已在下方「状态」列标出，建议人工核对后再交付。" />
            <InfoBar IsOpen="{Binding HasExport}" IsClosable="False" Severity="Success"
                     Title="导出完成" Message="{Binding LastExportInfo}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,284" ColumnSpacing="10" Margin="0,4,0,0">

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnSpacing="8" Padding="12,8,12,6"
                          ColumnDefinitions="44,124,96,180,96,52,*">
                        <TextBlock Grid.Column="0" Text="序号" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="票类型" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="施工区域" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="施工时间" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="起止页" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="页数" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>

                    <ListView x:Name="TicketsList" Grid.Row="1" Padding="0" SelectionMode="Single"
                              ItemsSource="{Binding Tickets}"
                              SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                              SelectionChanged="OnTicketsSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="12,7" ToolTipService.ToolTip="{Binding IssueText}"
                                      ColumnDefinitions="44,124,96,180,96,52,*">
                                    <TextBlock Grid.Column="0" Text="{Binding IndexText}"
                                               Style="{StaticResource CellStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Width="3" Height="16" CornerRadius="2"
                                                Background="{Binding TypeBrush}" />
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource CellStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Area}"
                                               Style="{StaticResource CellStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Time}"
                                               Style="{StaticResource CellStyle}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PageRange}"
                                               Style="{StaticResource CellStyle}" />
                                    <TextBlock Grid.Column="5" Text="{Binding PageCountText}"
                                               Style="{StaticResource CellStyle}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{Binding IssueShort}" FontSize="12"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding ShowPages, Converter={StaticResource BoolToVis}}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" Padding="12,10,12,6" ColumnSpacing="8" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="页面" Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPageLabel}" FontSize="11"
                                   Opacity="0.65" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="10,0,10,8" ColumnSpacing="6" ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Content="切开" FontSize="12" Padding="0,4"
                                HorizontalAlignment="Stretch" Command="{Binding SplitAtPageCommand}"
                                IsEnabled="{Binding CanEditBoundary}"
                                ToolTipService.ToolTip="以选中页为首页，切成新的一张票" />
                        <Button Grid.Column="1" Content="并入上张" FontSize="12" Padding="0,4"
                                HorizontalAlignment="Stretch" Command="{Binding MergePreviousCommand}"
                                IsEnabled="{Binding CanEditBoundary}"
                                ToolTipService.ToolTip="把选中页所在的票并入上一张票" />
                        <Button Grid.Column="2" Content="删除" FontSize="12" Padding="0,4"
                                HorizontalAlignment="Stretch" Command="{Binding DeleteTicketCommand}"
                                IsEnabled="{Binding HasTickets}"
                                ToolTipService.ToolTip="删除选中的票（其页面不再归档）" />
                    </Grid>
                    <ListView x:Name="PagesList" Grid.Row="2" Padding="0" SelectionMode="Single"
                              ItemsSource="{Binding Pages}"
                              SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                              SelectionChanged="OnPagesSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="2,3" ColumnDefinitions="24,*,26">
                                    <TextBlock Grid.Column="0" Text="{Binding PageNumberText}" FontSize="11"
                                               Opacity="0.7" VerticalAlignment="Top" />
                                    <Border Grid.Column="1" Background="White" CornerRadius="3"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Height="130" />
                                    </Border>
                                    <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12"
                                            VerticalAlignment="Top" Background="{Binding BadgeBrush}">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
