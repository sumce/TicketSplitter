<UserControl
    x:Class="TicketSplitter.App.Steps.SubmitStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="*,Auto" RowSpacing="14">
        <Border Grid.Row="0" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE8E5;" FontSize="32"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="把扫描件作业票 PDF 拖到这里" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock TextAlignment="Center" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                           Text="支持图像型扫描件。提交后先确认它是「每页一张票」还是「一面两页、左右并排」，确认后才送去 MinerU 识别。" />
                <Button Content="选择 PDF 文件…" HorizontalAlignment="Center" Padding="24,9"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding PickSourceCommand}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="最近打开" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{Binding RecentFiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnRecentClick" Tag="{Binding Path}" Padding="12,8" CornerRadius="8"
                                    ToolTipService.ToolTip="{Binding Path}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        <TextBlock Text="{Binding Folder}" FontSize="10.5" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
