<UserControl
    x:Class="TicketSplitter.App.Steps.LayoutStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnDefinitions="*,336" ColumnSpacing="14">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="这份 PDF 是哪种样式？" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionStyle}"
                           Text="程序已自动判断并用「推荐」标出。判断不对时改选下面的样式，或点「添加样式」自己定义一种。" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <InfoBar Grid.Column="0" IsOpen="{Binding HasNotes}" IsClosable="False" Severity="Warning"
                         Title="版式提示" Message="{Binding LayoutNotes}" />
                <Button Grid.Column="1" Content="添加样式…" VerticalAlignment="Top"
                        Click="OnAddStyleClick" />
            </Grid>

            <ListView Grid.Row="2" Padding="0" SelectionMode="Single"
                      ItemsSource="{Binding Styles}"
                      SelectedItem="{Binding SelectedStyle, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="12,10" ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="16" Opacity="0.55"
                                      VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <Border CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="推荐" FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                           Opacity="0.72" />
                                <TextBlock Text="{Binding Outcome}" FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="删除" FontSize="11" Padding="8,2"
                                    VerticalAlignment="Top" Tag="{Binding}" Click="OnDeleteStyleClick"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="切开效果预览" Style="{StaticResource PanelTitleStyle}" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="取第 1 页做示意" />
                <TextBlock Text="原始页面" FontSize="11" Opacity="0.7" />
                <Border Background="White" CornerRadius="4" BorderThickness="1" Padding="2"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Image Source="{Binding PreviewSource}" Stretch="Uniform" MaxHeight="200" />
                </Border>
                <StackPanel Spacing="4"
                            Visibility="{Binding HasSplitPreview, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="切开后（送去识别的就是这两页）" FontSize="11" Opacity="0.7" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Border Grid.Column="0" Background="White" CornerRadius="4" BorderThickness="1"
                                Padding="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image Source="{Binding PreviewFirst}" Stretch="Uniform" MaxHeight="140" />
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="4" BorderThickness="1"
                                Padding="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image Source="{Binding PreviewSecond}" Stretch="Uniform" MaxHeight="140" />
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
