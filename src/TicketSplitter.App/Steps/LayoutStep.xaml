<UserControl
    x:Class="TicketSplitter.App.Steps.LayoutStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnDefinitions="*,564" ColumnSpacing="16">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="这份 PDF 是哪种样式？" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="程序已自动判断并用「推荐」标出。判断不对时选别的样式，或自己添加一种。" />
                </StackPanel>
                <Button Grid.Column="1" Content="添加样式…" VerticalAlignment="Top" Click="OnAddStyleClick" />
            </Grid>

            <InfoBar Grid.Row="1" IsOpen="{Binding HasNotes}" IsClosable="False" Severity="Warning"
                     Title="版式提示" Message="{Binding LayoutNotes}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Styles}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Tapped="OnStyleTapped" Tag="{Binding}" Margin="0,0,0,10">
                                <Border CornerRadius="8" Padding="16,14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="18" ColumnDefinitions="Auto,*">
                                        <Grid Grid.Column="0" Width="96" Height="72">
                                            <Border Width="42" Height="68" CornerRadius="4" BorderThickness="1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}" />
                                            <Border Width="90" Height="58" CornerRadius="4" BorderThickness="1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    Visibility="{Binding IsLeftRight, Converter={StaticResource BoolToVis}}">
                                                <Grid ColumnDefinitions="*,1,*">
                                                    <Border Grid.Column="0" CornerRadius="3,0,0,3"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Opacity="0.22" />
                                                    <Rectangle Grid.Column="1"
                                                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                    <Border Grid.Column="2" CornerRadius="0,3,3,0"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Opacity="0.22" />
                                                </Grid>
                                            </Border>
                                            <Border Width="42" Height="68" CornerRadius="4" BorderThickness="1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    Visibility="{Binding IsTopBottom, Converter={StaticResource BoolToVis}}">
                                                <Grid RowDefinitions="*,1,*">
                                                    <Border Grid.Row="0" CornerRadius="3,3,0,0"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Opacity="0.22" />
                                                    <Rectangle Grid.Row="1"
                                                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                    <Border Grid.Row="2" CornerRadius="0,0,3,3"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Opacity="0.22" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                <Border CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="推荐" FontSize="10" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Opacity="0.68"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Outcome}" FontSize="12.5" Margin="0,2,0,0"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="8" BorderThickness="2"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,10,10,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="切开效果（取第 1 页示意）" Style="{StaticResource PanelTitleStyle}" />

                <StackPanel Spacing="5">
                    <TextBlock Text="原始页面" FontSize="11" Opacity="0.6" />
                    <Border CornerRadius="6" BorderThickness="1" Padding="4" Background="White"
                            HorizontalAlignment="Left"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Image Source="{Binding PreviewSource}" Stretch="Uniform" Height="250" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="5"
                            Visibility="{Binding HasSplitPreview, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74B;" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="切开后（送去识别的就是这两页）" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border CornerRadius="6" BorderThickness="1" Padding="4" Background="White"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image Source="{Binding PreviewFirst}" Stretch="Uniform" Height="230" />
                        </Border>
                        <Border CornerRadius="6" BorderThickness="1" Padding="4" Background="White"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image Source="{Binding PreviewSecond}" Stretch="Uniform" Height="230" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Padding="14" CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding HasSplitPreview, Converter={StaticResource BoolToVisInv}}">
                    <TextBlock Text="该样式不切开，整页原样送去识别。" Style="{StaticResource CaptionStyle}" />
                </Border>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Text="{Binding SourceName}" FontSize="12.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SourceMeta}" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="{Binding LayoutDetail}" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>