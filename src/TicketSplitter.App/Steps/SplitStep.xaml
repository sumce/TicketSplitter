<UserControl
    x:Class="TicketSplitter.App.Steps.SplitStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="正在按所选样式切开" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource CaptionStyle}"
                       Text="一面两页的扫描件必须先拆成单页，MinerU 才能逐页识别出票标题。切开只改裁剪框、不复制图片，体积不会翻倍。" />
        </StackPanel>

        <InfoBar Grid.Row="1" IsOpen="{Binding SplitDone}" IsClosable="False" Severity="Success"
                 Title="切开完成" Message="{Binding SplitSummary}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="14" VerticalAlignment="Top">
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="切开前" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SplitSourceLabel}" FontSize="44" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="页" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="切开后（送去识别）" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SplitResultLabel}" FontSize="44" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="页" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="中间文件" Style="{StaticResource PanelTitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="切开结果缓存在本机工作目录，换回同一样式时不会重复切；换其它样式会自动重切。" />
                    <TextBlock Text="{Binding LayoutDetail}" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
