<UserControl
    x:Class="TicketSplitter.App.Steps.ChunkPlanPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" Padding="16">
        <StackPanel Spacing="10">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="分块解析" Style="{StaticResource PanelTitleStyle}" />
                <Button Grid.Column="1" Content="恢复自动分块" FontSize="11" Padding="8,2"
                        Command="{Binding ResetChunksCommand}"
                        Visibility="{Binding NeedsChunking, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Text="{Binding ChunkSummary}" TextWrapping="Wrap" FontSize="12.5" />

            <ItemsControl ItemsSource="{Binding Chunks}"
                          Visibility="{Binding NeedsChunking, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" Padding="0,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <StackPanel Spacing="8">

                                <Grid ColumnSpacing="10" ColumnDefinitions="Auto,150,Auto,*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Range}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PageCountText}" FontSize="12"
                                               Opacity="0.65" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Content="再切一刀" FontSize="11" Padding="8,2"
                                            Click="OnSplitChunkClick" Tag="{Binding}" />
                                    <Button Grid.Column="5" Content="与下一块合并" FontSize="11" Padding="8,2"
                                            Click="OnMergeChunkClick" Tag="{Binding}"
                                            IsEnabled="{Binding CanMerge}" />
                                </Grid>

                                <StackPanel Spacing="4"
                                            Visibility="{Binding HasBoundary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding BoundaryHint}" FontSize="11" Opacity="0.6" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                        <ItemsControl ItemsSource="{Binding BoundaryPages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2" Tapped="OnBoundaryPageTapped"
                                                                Tag="{Binding}">
                                                        <Border BorderThickness="2" CornerRadius="4"
                                                                Background="White"
                                                                BorderBrush="{Binding FrameBrush}">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                                   Height="64" />
                                                        </Border>
                                                        <TextBlock Text="{Binding PageNumberText}" FontSize="9.5"
                                                                   HorizontalAlignment="Center" Opacity="0.6" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar IsOpen="{Binding HasChunkProblems}" IsClosable="False" Severity="Error"
                     Title="切点有问题，请调整">
                <InfoBar.Content>
                    <ItemsControl ItemsSource="{Binding ChunkProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </InfoBar.Content>
            </InfoBar>

            <TextBlock Style="{StaticResource CaptionStyle}"
                       Text="上面每个切点都把附近的实际页面摊了出来：红框是切点所在的最后一页，蓝框已属于下一块，点任意一页就能把切点挪到它之后。切点落在票中间也不影响结果——各块结果会按页号合并后再切票。" />
        </StackPanel>
    </Border>
</UserControl>
